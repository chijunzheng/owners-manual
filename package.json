{
  "name": "owners-manual",
  "version": "0.0.0",
  "private": true,
  "description": "The missing owner's manual for owning a condo — multi-corpus agentic RAG (TypeScript product; Python eval harness).",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "corpus:fetch": "tsx packages/corpus/src/cli.ts",
    "corpus:verify": "tsx packages/corpus/src/cli.ts --verify-only"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.18.13",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
